# Copy to .env and adjust as needed. All values are optional.

# Target environment (read by pytest-base-url)
# PYTEST_BASE_URL=https://www.saucedemo.com

# Shared password for Saucedemo test users
SAUCE_PASSWORD=secret_sauce

# Timeouts (ms)
EXPECT_TIMEOUT_MS=5000
SLOW_LOGIN_TIMEOUT_MS=15000

# AI failure analysis (pytest --ai-analysis)
# ANTHROPIC_API_KEY=
# AI_ANALYSIS_MODEL=claude-opus-5-5
# AI_ANALYSIS_EFFORT=medium
# Max failures analyzed per run (per xdist worker)
# AI_ANALYSIS_MAX=10
